            <div className="flex items-center gap-3 mb-4">
              {backendStatus === 'ok' && (
                <CheckCircle className="w-4 h-4 text-green-500" />
              )}
              {backendStatus === 'error' && (
                <AlertCircle className="w-4 h-4 text-red-500" />
              )}
              {backendStatus === 'loading' && (
                <div className="w-4 h-4 bg-yellow-500 rounded-full animate-pulse"></div>
              )}
              <h3 className="text-lg font-semibold text-white">Backend API</h3>
            </div>
            <p className="text-gray-300 mb-4">Express.js Server</p>
            <div className="text-sm font-mono bg-black/30 p-3 rounded text-indigo-400">
              http://localhost:3001/api
            </div>
            <p className="mt-3 text-xs text-gray-400">
              {backendStatus === 'ok' && '✅ Connected'}
              {backendStatus === 'error' && '❌ Cannot connect'}
              {backendStatus === 'loading' && '⏳ Checking...'}
            </p>
          </div>

          {/* WebSocket Status */}
          <div className="bg-white/5 backdrop-blur border border-white/10 rounded-lg p-6 hover:bg-white/10 transition">
            <div className="flex items-center gap-3 mb-4">
              <div className="w-4 h-4 bg-blue-500 rounded-full animate-pulse"></div>
              <h3 className="text-lg font-semibold text-white">WebSocket</h3>
            </div>
            <p className="text-gray-300 mb-4">Real-time Communication</p>
            <div className="text-sm font-mono bg-black/30 p-3 rounded text-blue-400">
              ws://localhost:3001
            </div>
            <p className="mt-3 text-xs text-gray-400">Socket.io Ready</p>
          </div>

          {/* Frontend Status */}
          <div className="bg-white/5 backdrop-blur border border-white/10 rounded-lg p-6 hover:bg-white/10 transition">
            <div className="flex items-center gap-3 mb-4">
