                <p className="font-mono text-sm text-blue-300 ml-4">
                  <span className="text-purple-300">Backend API</span>
                  <span className="text-gray-500"> → </span>
                  <span className="text-green-300">Firebase/Supabase</span>
                </p>
                <p className="font-mono text-sm text-blue-300 ml-4 mt-2">
                  <span className="text-pink-300">WebSocket (Socket.io)</span>
