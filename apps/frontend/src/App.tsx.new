            </div>

            <div className="bg-black/30 p-4 rounded border border-white/10">
              <p className="text-white font-mono text-sm mb-2">API Endpoints Available:</p>
              <ul className="text-gray-400 text-xs space-y-1 font-mono">
                <li>🔐 POST /api/auth/login</li>
                <li>📦 GET /api/orders</li>
                <li>👷 GET /api/artisans</li>
                <li>➕ POST /api/orders (create)</li>
              </ul>
            </div>
          </div>
        </div>

        {/* Getting Started */}
        <div className="bg-white/5 backdrop-blur border border-white/10 rounded-lg p-8 mb-12">
          <h3 className="text-2xl font-bold text-white mb-6">🚀 Getting Started</h3>
          
          <div className="space-y-4">
