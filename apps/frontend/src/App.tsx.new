        <div className="bg-white/5 backdrop-blur border border-white/10 rounded-lg p-8 mb-12">
          <h3 className="text-2xl font-bold text-white mb-6">🧪 Quick Test API</h3>
          
          <div className="space-y-4">
            <div className="bg-black/30 p-4 rounded border border-white/10">
              <p className="text-white font-mono text-sm mb-2">Test Backend Health:</p>
              <code className="text-gray-400 text-xs">GET http://localhost:3001/health</code>
