# Ignore local node_modules
node_modules
**/node_modules

# Ignore build outputs
dist
**/dist
build
.next
.vercel
out

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment variables
.env
.env.*
!.env.example

# Ignore git and IDE config
.git
.gitignore
.github
.vscode
.idea
.DS_Store

# Ignore documentation and archives
docs
archive
*.md

# Ignore Docker files themselves to avoid rebuilding when they change slightly
Dockerfile
docker-compose.yml
.dockerignore
